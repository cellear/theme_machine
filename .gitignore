# OS files
.DS_Store

# Claude Code local state
.claude/

# ---- _workspace/ (development environment) ----

# Local dev environment (allow ddev PHP overrides for short_open_tag)
_workspace/.ddev/
_workspace/backdrop/.ddev/*
!_workspace/backdrop/.ddev/php/
_workspace/backdrop/.ddev/php/*
!_workspace/backdrop/.ddev/php/short-open-tag.ini

# Reference Drupal 7 install
_workspace/drupal-7/

# Backdrop CMS install (tracked selectively)
_workspace/backdrop/

# Backdrop site data (config, uploads, private files)
_workspace/backdrop/files/
_workspace/backdrop/private/

# Backdrop's original git metadata
_workspace/backdrop/.git.original/

# D7 themes under test
_workspace/backdrop/themes/

# Node dependencies
_workspace/node_modules/

# Generated output
_workspace/screenshots/
_workspace/reports/

# Working notes
_workspace/Notes/
_workspace/Context.docx

# Incoming theme clones
INCOMING/

# Agent handoff protocol source (upstream repo)
agent-handoff/
